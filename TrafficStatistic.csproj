<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built against the game's own Mono class libraries (Cities2_Data\Managed), no NuGet packages. -->
  <!-- The game folder: GameDir.props next to this file (not in git), or -p:GameDir=..., or the Steam default. -->
  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>TrafficStatistic</AssemblyName>
    <RootNamespace>TrafficStatistic</RootNamespace>
    <Version>0.6.3</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II</GameDir>
    <Managed>$(GameDir)\Cities2_Data\Managed</Managed>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoStdLib>true</NoStdLib>
    <!-- No .NET Framework targeting pack is installed: treat the game's folder as the framework. -->
    <FrameworkPathOverride>$(Managed)</FrameworkPathOverride>
    <_TargetFrameworkDirectories>$(Managed)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(Managed)</_FullFrameworkReferenceAssemblyPaths>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <GameRef Include="mscorlib;netstandard;System;System.Core;UnityEngine.CoreModule;Unity.Entities;Unity.Collections;Unity.Mathematics;Game;Colossal.Core;Colossal.Mathematics;Colossal.Logging;Colossal.UI.Binding;Colossal.Localization;Colossal.PSI.Common;Colossal.IO.AssetDatabase" />
    <Reference Include="@(GameRef)">
      <HintPath>$(Managed)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
